# Native Nuxt + MariaDB (no Docker). Copy to .env for the local installation.
DB_HOST=127.0.0.1
DB_PORT=3306
# PHP transition compatibility: same local database, not a second instance.
DB_PUBLISH_PORT=3306
DB_NAME=gamified
DB_USER=root
DB_PASSWORD=
ACADEMIC_YEAR=2569
SEMESTER=1
# Optional first-install admin password. Empty uses admin1234 and forces a change.
ADMIN_PASSWORD=
