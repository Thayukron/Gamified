{
  "name": "gamified-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "db:upgrade": "node --env-file-if-exists=.env scripts/upgrade-db.mjs",
    "typecheck:server": "nuxt prepare && tsc --noEmit -p tsconfig.server.json",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "docx": "^9.11.0",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "mysql2": "^3.24.6",
    "nuxt": "^3.21.11",
    "pinia": "^3.0.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
