# ARCANA PROFILE - reference only; configure .env manually for your server.
# Never overwrite an existing .env when installing or updating.
# .env is not committed to git.

# Web server: npm start and npm run dev both use PORT
PORT=3000

# Database - local MariaDB service (127.0.0.1:3306)
DB_HOST=localhost
DB_PORT=3306
DB_PUBLISH_PORT=3306
DB_NAME=gamified
DB_USER=root
DB_PASSWORD=

# Current academic term (game results are counted per term)
ACADEMIC_YEAR=2569
SEMESTER=1

# First install only (empty database):
#   run `npm run db:init -- --create-empty` (creates tables + admin account)
# Admin password on first install - empty = admin1234 and must be changed on first login
ADMIN_PASSWORD=
